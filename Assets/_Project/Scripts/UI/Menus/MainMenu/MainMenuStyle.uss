VisualElement {
}

:root {
    /* Estética Keycap (Blanco Mecánico) */
    --color-key-bg: rgb(245, 245, 245);
    --color-key-bg-hover: rgb(255, 255, 255);
    --color-key-shadow: rgb(180, 180, 180);
    --color-key-shadow-active: rgb(120, 120, 120);
    
    /* Ventana y Carcasa */
    --color-bg-window: rgba(20, 20, 20, 0.7);
    --color-border-window: rgba(255, 255, 255, 0.1);
    
    /* Variaciones de Teclas */
    --color-key-blue: rgb(225, 235, 255);
    --color-key-red: rgb(255, 220, 220);
    --color-text-key: rgb(55, 55, 55);
    
    /* Configuración de Fuente */
    --font-pixel: url("project://database/Assets/_Project/Art/Fonts/Minecraft.ttf?fileID=12800000&guid=b88d3f209c0bbd44db924756b919bc69&type=3#Minecraft");
    --font-size-key: 22px;
    
    /* Geometría de Tecla */
    --key-depth: 10px;
    --key-depth-active: 2px;
    --key-radius: 12px;
}

.menu-screen {
    flex-grow: 1;
    flex-direction: row;
    padding: 40px;
}

.menu__center-panel {
    flex-grow: 2;
    align-items: center;
    justify-content: center;
}

.menu__logo-wrapper {
    margin-bottom: 50px;
}

.logo-image {
    width: 500px;
    height: 250px;
    background-image: url("project://database/Assets/_Project/Art/Sprites/Logos/GDUNI.jpg?fileID=21300000&guid=b28318cca5736524b923bce52dd261db&type=3#GDUNI");
    -unity-background-scale-mode: scale-to-fit;
}

.identity-card {
    width: 440px;
    background-color: var(--color-bg-window);
    padding: 20px;
    border-radius: 20px;
    margin-bottom: 25px;
    border-width: 2px;
    border-color: var(--color-border-window);
}

.identity-label {
    color: var(--color-key-bg);
    -unity-font-definition: var(--font-pixel);
    font-size: 14px;
    margin-bottom: 10px;
    opacity: 0.8;
    -unity-font-style: bold;
}

.identity__input-group {
    flex-direction: row;
    width: 100%;
    align-items: flex-start;
}

.input-field--name {
    flex-grow: 1;
    height: 60px;
    background-color: var(--color-key-bg);
    border-radius: var(--key-radius);
    border-width: 2px;
    border-bottom-width: 8px;
    border-color: var(--color-key-shadow);
    color: var(--color-text-key);
    -unity-font-definition: var(--font-pixel);
    font-size: 22px;
    -unity-text-align: middle-center;
    padding: 0;
    margin-right: 12px;
}

.input-field--name:focus {
    border-color: rgb(100, 180, 255);
    background-color: white;
}

.button--update {
    width: 60px;
    height: 60px;
    background-color: var(--color-key-blue);
    border-radius: var(--key-radius);
    border-width: 2px;
    border-bottom-width: 8px;
    border-color: rgb(170, 185, 210);
    color: var(--color-text-key);
    -unity-font-definition: var(--font-pixel);
    -unity-font-style: bold;
    font-size: 18px;
    margin: 0;
    transition-duration: 0.05s;
}

.button--update:hover {
    background-color: white;
}

.button--update:active {
    border-bottom-width: var(--key-depth-active);
    margin-top: 6px;
    background-color: rgb(200, 220, 240);
}

.menu__button-group {
    width: 440px;
    padding: 30px;
    background-color: var(--color-bg-window);
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--color-border-window);
    gap: 18px;
}

.button--menu {
    width: 100%;
    height: 65px;
    margin: 0;
    -unity-font-definition: var(--font-pixel);
    -unity-font-style: bold;
    font-size: var(--font-size-key);
    color: var(--color-text-key);
    background-color: var(--color-key-bg);
    border-radius: var(--key-radius);
    border-width: 2px;
    border-color: var(--color-key-shadow);
    border-bottom-width: var(--key-depth);
    transition-duration: 0.05s;
}

.button--primary { 
    background-color: var(--color-key-bg); 
}

.button--secondary { 
    background-color: var(--color-key-blue);
    border-color: rgb(170, 185, 210); 
}

.button--danger { 
    background-color: var(--color-key-red);
    border-color: rgb(200, 160, 160); 
}

.button--menu:hover { 
    background-color: var(--color-key-bg-hover);
    scale: 1.02;
}

.button--menu:active {
    border-bottom-width: var(--key-depth-active);
    margin-top: 8px;
    background-color: rgb(220, 220, 220);
    border-color: var(--color-key-shadow-active);
}

.menu__version-text {
    color: rgba(255, 255, 255, 0.2);
    -unity-font-definition: var(--font-pixel);
    font-size: 14px;
    margin-bottom: 15px;
}
