VisualElement {}

.button-menu {
    /* Layout & Box */
    margin: 10px 5px;
    padding: 10px 20px;
    border-width: 4px;
    border-bottom-width: 8px;
    border-radius: 10px;

    /* Colors */
    background-color: #4A4A4A;
    border-color: #000000;
    color: #FFFFFF;

    /* Text */
    font-size: 36px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Minecraft.ttf");

    /* Animation & Interaction */
    transition-duration: 0.1s;
}

.button-menu:hover {
    background-color: #5A5A5A;
    border-bottom-width: 10px;
}

.button-menu:active {
    background-color: #333333;
    border-bottom-width: 2px;
    margin-top: 11px;
}

.button-options {
    /* Layout & Box */
    margin: 10px 5px;
    padding: 10px 20px;
    border-width: 4px;
    border-bottom-width: 8px;
    border-radius: 10px;

    /* Colors */
    background-color: #4A4A4A;
    border-color: #000000;
    color: #FFFFFF;

    /* Text */
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Minecraft.ttf");

    /* Animation & Interaction */
