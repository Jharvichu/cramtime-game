VisualElement {}

/* ====== 0. VARIABLES DE DISEÑO (TOKENS) ====== */
:root {
    /* Colores de la Ficha */
    --color-bg-card: rgba(255, 255, 255, 0.85); /* Blanco papel */
    --color-border-card: rgb(180, 180, 190);
    --color-avatar-bg: rgb(45, 45, 48);        /* Fondo oscuro para contraste */
    
    /* Colores del Botón Kick */
    --color-key-red: rgb(255, 200, 200);       /* Rojo suave */
    --color-key-shadow-red: rgb(200, 160, 160);
    
    /* Texto */
    --color-text-dark: rgb(40, 40, 45);
    --color-text-key: rgb(50, 50, 55);
    
    /* Fuentes y Geometría */
    --font-pixel: url("project://database/Assets/_Project/Art/Fonts/Minecraft.ttf?fileID=12800000&guid=b88d3f209c0bbd44db924756b919bc69&type=3#Minecraft");
    --key-radius: 10px;
}

/* ====== 1. CONTENEDOR PRINCIPAL (LA TARJETA) ====== */
.player-entry {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg-card);
    margin-bottom: 8px;
    padding: 10px 14px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-border-card);
    /* Sutil transición al pasar el mouse */
    transition-duration: 0.1s;
}

.player-entry:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(100, 180, 255); /* Azul UNI al hacer hover */
    scale: 1.01;
}

/* ====== 2. AVATAR / IMAGEN DEL PERSONAJE ====== */
.player-entry__avatar {
    width: 50px;
    height: 50px;
    background-color: var(--color-avatar-bg);
    border-radius: 8px;
    margin-right: 15px;
    border-width: 2px;
    border-color: var(--color-border-card);
    /* Optimización para Pixel Art */
    -unity-background-scale-mode: scale-to-fit;
}

/* ====== 3. SECCIÓN DE TEXTO ====== */
.player-entry__info {
    flex-grow: 1;
    justify-content: center;
}

.player-entry__name {
    color: var(--color-text-dark);
    -unity-font-definition: var(--font-pixel);
    -unity-font-style: bold;
    font-size: 16px;
    margin: 0;
    padding: 0;
}

.player-entry__modality {
    color: var(--color-text-dark);
    -unity-font-definition: var(--font-pixel);
    font-size: 11px;
    opacity: 0.7;
    margin-top: 2px;
    -unity-font-style: italic;
}

/* ====== 4. BOTÓN DE EXPULSAR (TECLA MECÁNICA PEQUEÑA) ====== */
.button--kick {
    width: 60px;
    height: 35px;
    background-color: var(--color-key-red);
    border-radius: 8px;
    border-width: 1px;
    border-bottom-width: 5px; /* Efecto tecla */
    border-color: var(--color-key-shadow-red);
    color: var(--color-text-key);
    -unity-font-definition: var(--font-pixel);
    -unity-font-style: bold;
    font-size: 10px;
    margin-left: 10px;
    transition-duration: 0.05s;
}

.button--kick:hover {
    background-color: rgb(255, 220, 220);
}

.button--kick:active {
    border-bottom-width: 1px;
    margin-top: 4px; /* Simula que se hunde */
    background-color: rgb(240, 180, 180);
}